# Bank Rock — environment template
# Target network: Ethereum Sepolia (11155111). See specs/16-environment-and-secrets.md for
# what each value is, who provides it, and which phase needs it.
#
# Variable names below are the ones the code reads TODAY. Names marked (rename) are
# consolidated in Phase 1 of specs/15-exit-demo-mode.md.
# Never commit a real .env. Set production values in the Cloudflare Pages dashboard.

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bank-rock.com
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_DEMO_MODE=false

# ── Auth: Privy (dashboard.privy.io — also whitelist the origin and enable Sepolia)
NEXT_PUBLIC_PRIVY_APP_ID=

# ── RPC (Alchemy / Infura Sepolia endpoint; public RPCs reject wide eth_getLogs)
# Both names are read today; set both to the same value until the rename lands.
BASE_SEPOLIA_RPC_URL=        # (rename → SEPOLIA_RPC_URL)
RPC_URL=                     # (rename → SEPOLIA_RPC_URL)

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=              # openssl rand -hex 16
ADMIN_JWT_SECRET=            # openssl rand -hex 32  — REQUIRED; fallback is forgeable
ADMIN_API_KEY=               # openssl rand -hex 32  — newsletter operator view
CRON_SECRET=                 # openssl rand -hex 32

# ── Contracts (Ethereum Sepolia) ───────────────────────────────────────────────
# Verified 2026-09-12 — see specs/16 §1.1
NEXT_PUBLIC_AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
# Outputs of our own deploys (Phase 2 / Phase 3). Empty until deployed.
NEXT_PUBLIC_REGISTRY_ADDRESS=
REGISTRY_ADDRESS=            # same value; read by mcp/ and contracts/scripts (rename → one name)
NEXT_PUBLIC_SWAPVM_ROUTER_ADDRESS=

# ── Account abstraction: Pimlico (dashboard.pimlico.io — create a sponsorship policy for 11155111)
PIMLICO_API_KEY=
NEXT_PUBLIC_PIMLICO_API_KEY= # same key; browser-visible — restrict by origin in the dashboard

# ── Hot wallets (fresh keys, never reused across roles) ────────────────────────
FAUCET_PRIVATE_KEY=          # REQUIRED; funded with Sepolia ETH; sends 0.01 ETH per claim
SIGNER_PRIVATE_KEY=          # (rename → ATTESTATION_SIGNER_PRIVATE_KEY) unfunded; NFC attestations

# ── NFC: NTAG 424 DNA ──────────────────────────────────────────────────────────
NXP_MASTER_KEY=              # 16-byte hex; must equal the key written to the tags. Was mislabelled NTAG_MASTER_KEY.

# ── Email: Resend (verify bank-rock.com first — sandbox only delivers to your own inbox)
RESEND_API_KEY=
ALERT_EMAIL_ADDRESS=

# ── Optional ───────────────────────────────────────────────────────────────────
# ALCHEMY_WEBHOOK_SECRET=    # only if Alchemy Notify is used; route must reject when unset
# UPSTASH_REDIS_REST_URL=    # superseded by D1
# UPSTASH_REDIS_REST_TOKEN=

# ── Removed ────────────────────────────────────────────────────────────────────
# 1INCH_API_KEY              # 1inch Swap API is mainnet-only; /api/quote is deleted
