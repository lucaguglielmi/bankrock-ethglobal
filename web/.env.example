# Bank Rock — environment template
# Target network: Ethereum Sepolia (11155111). See specs/16-environment-and-secrets.md for what
# each value is, who provides it, and which phase needs it.
#
# Every variable below is read by the code as spelled here. Anything the code does not read has
# been removed. Never commit a real .env — set production values in the Cloudflare dashboard.

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bank-rock.com
NEXT_PUBLIC_CHAIN_ID=11155111
# "true" enables badged simulation. Any other value, including unset, means off (D-013).
NEXT_PUBLIC_DEMO_MODE=false

# ── Auth: Privy (dashboard.privy.io — whitelist the origin and enable Sepolia) ──
# Unset: sign-in renders UNAVAILABLE and no wallet address is shown anywhere.
NEXT_PUBLIC_PRIVY_APP_ID=

# ── RPC ────────────────────────────────────────────────────────────────────────
# Alchemy or Infura Sepolia endpoint. Public RPCs reject wide eth_getLogs, which the indexer needs.
SEPOLIA_RPC_URL=
# Block the registry was deployed in. The indexer scans forward from here in 2,000-block chunks;
# unset means provenance is UNAVAILABLE rather than scanned from block 0.
REGISTRY_DEPLOY_BLOCK=

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=              # openssl rand -hex 16 — unset closes the admin console
ADMIN_JWT_SECRET=            # openssl rand -hex 32 — REQUIRED; there is no fallback secret
ADMIN_API_KEY=               # openssl rand -hex 32 — x-admin-key for /api/telemetry, /api/newsletter
CRON_SECRET=                 # openssl rand -hex 32 — x-cron-secret header for cron, keeper, gelato

# ── Contracts (Ethereum Sepolia) ───────────────────────────────────────────────
# Verified on chain 2026-09-12 — specs/16 §1.1. These are the only place addresses may live.
NEXT_PUBLIC_AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
# Outputs of our own deploys. Empty until deployed; the dependent capability is UNAVAILABLE.
NEXT_PUBLIC_REGISTRY_ADDRESS=
# Printed by contracts/scripts/deploy-aqua-app.js: the reference XYCSwap AquaApp strategies are
# shipped to, and the XYCSwapTaker periphery a visitor calls (a taker must be a contract —
# contracts/aqua/NOTES.md §5).
NEXT_PUBLIC_AQUA_APP_ADDRESS=
NEXT_PUBLIC_AQUA_TAKER_ADDRESS=
# The block the app was deployed in. Bounds the fee-history log scan; without it the figure is
# read over a short recent window and reported as partial.
AQUA_APP_DEPLOY_BLOCK=
# No SwapVM router address: that path was not taken. See contracts/scripts/deploy-swapvm-router.md.

# ── Account abstraction: Pimlico ───────────────────────────────────────────────
# dashboard.pimlico.io — create a sponsorship policy for chain 11155111 or every UserOp is rejected.
PIMLICO_API_KEY=
NEXT_PUBLIC_PIMLICO_API_KEY= # same key, browser-visible — restrict it by origin in the dashboard

# ── Hot wallets (fresh keys, never reused across roles) ────────────────────────
# REQUIRED for /api/faucet; unset means the faucet is UNAVAILABLE. There is no default key.
FAUCET_PRIVATE_KEY=
# Unfunded. Signs the EIP-712 NFC attestations; its address is the registry's trusted attester.
ATTESTATION_SIGNER_PRIVATE_KEY=
# Funded with Sepolia ETH. Pays gas for POST /api/rocks/[id]/claim, because a gift recipient has
# no gas and does not yet own the Rock Account. Unset means claims are UNAVAILABLE, never free.
RELAYER_PRIVATE_KEY=

# ── NFC: NTAG 424 DNA ──────────────────────────────────────────────────────────
# 16-byte hex (32 characters); must equal the key written to the physical tags.
# Cloudflare secret only — never a file. Unset means NFC verification is UNAVAILABLE.
NXP_MASTER_KEY=
# Optional, default off. "true" enables AN10922 per-tag key diversification; the app id is the
# 3-byte AID used in the derivation. Both must match how the tags were provisioned.
# NXP_KEY_DIVERSIFY=false
# NXP_KEY_DIVERSIFY_APP_ID=

# ── Email: Resend ──────────────────────────────────────────────────────────────
# Until bank-rock.com is verified in Resend, the sandbox sender only reaches your own inbox.
RESEND_API_KEY=
ALERT_FROM_ADDRESS=          # e.g. "Bank Rock <alerts@bank-rock.com>" once the domain is verified
ALERT_EMAIL_ADDRESS=         # the inbox that receives keeper alerts. No default: unset means
                             # /api/alerts/gelato answers UNAVAILABLE rather than mailing anyone.

# ── Webhooks ───────────────────────────────────────────────────────────────────
# Only if Alchemy Notify is used. Unset means /api/webhooks/alchemy rejects every payload (D-017).
ALCHEMY_WEBHOOK_SECRET=

# ── Migrations / tooling only (not read at runtime; the Worker uses the DB binding) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=      # f0a28d6f-0a36-46aa-b711-8b5297913d2e
CLOUDFLARE_D1_TOKEN=
