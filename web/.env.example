# Bank Rock — environment template
# Target network: Ethereum Sepolia (11155111). See specs/16-environment-and-secrets.md for what
# each value is, who provides it, and which phase needs it.
#
# Every variable below is read by the code as spelled here. Anything the code does not read has
# been removed. This file stays the authoritative list; copy it to `.env.local` for local work.
# Never commit a real .env.
#
# IN PRODUCTION each value has exactly one home, and this file says which (D-034, specs/12):
#
#   [1] git         — web/wrangler.jsonc `vars`. Committed, reviewed, and the only place these
#                     values are typed. `wrangler deploy` replaces the Worker's plain-text
#                     variables with this block on every deploy, so a value typed into the
#                     Cloudflare dashboard survives only until the next deploy.
#   [2] GitHub      — account-specific public identifiers, passed into the build by
#                     .github/workflows/deploy.yml. Not in git, not secret.
#   [3] Worker      — encrypted secrets on the Cloudflare Worker `web` (`wrangler secret put NAME`
#                     or dashboard → Settings → Variables and Secrets → **Secret**). Never in git,
#                     and never printed by a deploy. A deploy never touches them.
#                     A few values here are not secret in the cryptographic sense — they are
#                     account-specific and belong to the operator — but a *plain-text* Worker
#                     variable is deleted by the next deploy, so Secret is the only home on the
#                     Worker that survives one.
#
# NEXT_PUBLIC_* values are inlined by Next.js at build time. The deploy job exports the [1] ones
# out of wrangler.jsonc into the build environment (web/scripts/export-public-vars.mjs), so they
# reach both the bundle and the Worker runtime from one file.


# ══ [1] In git — web/wrangler.jsonc `vars` ════════════════════════════════════
# Non-secret, account-independent configuration. Change it there, not here and not in the
# dashboard. The values shown are the ones deployed today; `scripts/spec-checks.sh` (D-034) fails
# if the address and block vars stop matching contracts/deployments/*.json.

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bank-rock.com
NEXT_PUBLIC_CHAIN_ID=11155111
# "true" enables badged simulation. Any other value, including unset, means off (D-013).
NEXT_PUBLIC_DEMO_MODE=false

# ── Contracts: fixed, published (Ethereum Sepolia) ─────────────────────────────
# Verified on chain 2026-09-12 — specs/16 §1.1. lib/chain is the only reader (D-015).
NEXT_PUBLIC_AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14

# ── Contracts: our own deploys ─────────────────────────────────────────────────
# Recorded by the deploy scripts in contracts/deployments/sepolia.json and
# contracts/deployments/sepolia-aqua-app.json; copied into wrangler.jsonc from there.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x2A3101Fc525C6DBEc39bef45034E23b13f28F757
# Block the registry was deployed in. The indexer scans forward from here in 2,000-block chunks;
# unset means provenance is UNAVAILABLE rather than scanned from block 0.
REGISTRY_DEPLOY_BLOCK=11689716
# The reference XYCSwap AquaApp strategies are shipped to, and the XYCSwapTaker periphery a
# visitor calls (a taker must be a contract — contracts/aqua/NOTES.md §5).
NEXT_PUBLIC_AQUA_APP_ADDRESS=0x8a293F43Eb0DBaA834b40b2eC4E0751e3ce6316B
NEXT_PUBLIC_AQUA_TAKER_ADDRESS=0xCd7899E37D50B226E882e79572AB189080fD0016
# The block the app was deployed in. Bounds the fee-history log scan; without it the figure is
# read over a short recent window and reported as partial.
AQUA_APP_DEPLOY_BLOCK=11689724
# No SwapVM router address: that path was not taken. See contracts/scripts/deploy-swapvm-router.md.

# ── Relayer budget ─────────────────────────────────────────────────────────────
# How much the relayer may spend per UTC day, in wei, accumulated in D1 and checked before each
# claim is broadcast. UNSET OR 0 DISABLES RELAYING — an uncapped funded key is the finding this
# closes, so "no cap" is the closed branch, not the permissive one. 0.02 ETH, the deployed value.
RELAYER_DAILY_CAP_WEI=20000000000000000


# ══ [2] GitHub Actions inputs — account-specific, public, not in git ══════════
# Set once by the operator, read by .github/workflows/deploy.yml and inlined into the build.

# Repository *variable*  →  Settings → Secrets and variables → Actions → Variables
# dashboard.privy.io — whitelist the origin and enable Sepolia.
# Unset: sign-in renders UNAVAILABLE and no wallet address is shown anywhere.
NEXT_PUBLIC_PRIVY_APP_ID=cmtytvqip029c0djknzi8qz4t

# Repository *secret* (browser-visible by construction, but still a key: restrict it by origin in
# the Pimlico dashboard, and do not commit it).
NEXT_PUBLIC_PIMLICO_API_KEY=


# ══ [3] Worker secrets — `wrangler secret put NAME`, never in git ═════════════

# ── RPC ────────────────────────────────────────────────────────────────────────
# Alchemy or Infura Sepolia endpoint. Public RPCs reject wide eth_getLogs, which the indexer needs.
SEPOLIA_RPC_URL=

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=              # openssl rand -hex 16 — unset closes the admin console
ADMIN_JWT_SECRET=            # openssl rand -hex 32 — REQUIRED; there is no fallback secret
ADMIN_API_KEY=               # openssl rand -hex 32 — x-admin-key for /api/telemetry, /api/newsletter
CRON_SECRET=                 # openssl rand -hex 32 — x-cron-secret header for the snapshot cron and /api/alerts/gelato

# ── Account abstraction: Pimlico ───────────────────────────────────────────────
# dashboard.pimlico.io — create a sponsorship policy for chain 11155111 or every UserOp is rejected.
# Server-side copy of the key in [2].
PIMLICO_API_KEY=

# ── Hot wallets (fresh keys, never reused across roles) ────────────────────────
# REQUIRED for /api/faucet; unset means the faucet is UNAVAILABLE. There is no default key.
FAUCET_PRIVATE_KEY=
# Unfunded. Signs the EIP-712 NFC attestations; its address is the registry's trusted attester.
ATTESTATION_SIGNER_PRIVATE_KEY=
# Funded with Sepolia ETH. Pays gas for POST /api/rocks/[id]/claim, because a gift recipient has
# no gas and does not yet own the Rock Account. Unset means claims are UNAVAILABLE, never free.
# Pairs with RELAYER_DAILY_CAP_WEI in [1]: both are needed, neither is enough.
RELAYER_PRIVATE_KEY=

# ── NFC: NTAG 424 DNA ──────────────────────────────────────────────────────────
# 16-byte hex (32 characters); must equal the key written to the physical tags.
# Worker secret only — never a file. Unset means NFC verification is UNAVAILABLE.
NXP_MASTER_KEY=
# Optional, default off. "true" enables AN10922 per-tag key diversification; the app id is the
# 3-byte AID used in the derivation. Both must match how the tags were provisioned. Not in
# wrangler.jsonc because off is the default and the hackathon tags are provisioned without it.
# NXP_KEY_DIVERSIFY=false
# NXP_KEY_DIVERSIFY_APP_ID=

# ── Email: Resend ──────────────────────────────────────────────────────────────
# Until bank-rock.com is verified in Resend, the sandbox sender only reaches your own inbox.
RESEND_API_KEY=
# Not secret, but both depend on which sender and inbox the operator actually owns and has
# verified, so they are Worker variables rather than committed configuration.
ALERT_FROM_ADDRESS=          # e.g. "Bank Rock <alerts@bank-rock.com>" once the domain is verified
ALERT_EMAIL_ADDRESS=         # the inbox that receives operational alerts. No default: unset means
                             # /api/alerts/gelato answers UNAVAILABLE rather than mailing anyone.

# ── Webhooks ───────────────────────────────────────────────────────────────────
# Only if Alchemy Notify is used. Unset means /api/webhooks/alchemy rejects every payload (D-017).
ALCHEMY_WEBHOOK_SECRET=

# ── Web Push (spec 14; optional — all three unset means push is UNAVAILABLE) ─
# Generate a pair with: npx web-push generate-vapid-keys.
# The public half is NEXT_PUBLIC_, so a Worker variable would never reach the browser bundle: when
# push is enabled, add the generated value to wrangler.jsonc `vars` — [1] — where the build can
# inline it. It is public by construction. The other two stay here, in [3].
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=                 # mailto: or https: URL you own, e.g. mailto:security@bank-rock.com


# ══ Migrations / tooling only ═════════════════════════════════════════════════
# Not read at runtime; the Worker uses the DB binding in wrangler.jsonc. These live in the
# operator's shell or a local .env, and CLOUDFLARE_API_TOKEN is a GitHub Actions secret (spec 16
# §2.3.1) rather than any of the three homes above.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=      # f0a28d6f-0a36-46aa-b711-8b5297913d2e
CLOUDFLARE_D1_TOKEN=

# DEMO ONLY (DEMO-STATE S-4). When set on the Worker, GET /api/demo/tap?key=<value> forges a tap for
# a synthetic tag and redirects into the real flow — the chip is the only thing simulated. Unset it
# after the demo and the route answers 404.
DEMO_TAP_SECRET=
